# Configuração Docker Compose na raiz. Não é carregada automaticamente pelo Java.
# Gere valores com openssl rand -hex 32.
API_TOKEN=
DB_USERNAME=postgres
DB_PASSWORD=
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# true em HTTPS; false apenas em testes locais por HTTP.
SESSION_COOKIE_SECURE=true
# framework quando houver proxy HTTPS confiável enviando cabeçalhos Forwarded.
SERVER_FORWARD_HEADERS_STRATEGY=none
