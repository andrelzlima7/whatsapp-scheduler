# O Spring não lê .env automaticamente. Carregue no shell conforme o README.
DB_URL=jdbc:postgresql://127.0.0.1:5432/whatsapp_scheduler
DB_USERNAME=postgres
# Informe a senha do seu PostgreSQL local (postgres no ambiente inicial).
DB_PASSWORD=
ADMIN_LOGIN=admin
# Obrigatória apenas na primeira inicialização: mínimo 12 caracteres, máximo 72 bytes.
ADMIN_PASSWORD=
WHATSAPP_WORKER_URL=http://127.0.0.1:3001
# Mesmo valor de API_TOKEN do serviço Node.
WHATSAPP_WORKER_TOKEN=
PORT=8080
SERVER_ADDRESS=127.0.0.1
SESSION_COOKIE_SECURE=false
# Modo padrão: scripts SQL aplicados manualmente.
FLYWAY_ENABLED=false
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL=30000
SCHEDULER_TOLERANCE_MINUTES=30
